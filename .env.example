# Intent Kafka worker (workers/intent_kafka_worker.py). Copy to .env and fill in.
# Only variables the worker code actually reads are listed. Never commit real values.

# ---- Kafka ----
# Kafka is reached by its compose service name on pipeline-net. Never an IP.
KAFKA_BOOTSTRAP_SERVERS=kafka-service:9092
# ONE consumer group for the whole intent stream. Members of a group split the partitions
# (parallel, not duplicate). Do not point a second service at the same topics with a
# different group id: every event would be processed twice.
INTENT_KAFKA_GROUP_ID=intent-pipeline-workers
# Topics created by kafka-service/topics.conf (checkout 2, atc 2, click 3, other 3 partitions).
INTENT_KAFKA_TOPICS=intent.checkout,intent.atc,intent.click,intent.other
# Poison records (invalid payload, unknown brand, rows MySQL rejects after the attempt limit)
# are copied here, never dropped. The topic MUST exist before the worker starts: add
#   intent.dlq 1 604800000 1073741824
# to kafka-service/topics.conf and re-run kafka-init. The worker exits if it is missing.
INTENT_DLQ_TOPIC=intent.dlq

# ---- Batching and parallelism ----
# Records per MySQL transaction (per brand) and the longest wait to fill a batch.
INTENT_KAFKA_BATCH_SIZE=200
INTENT_KAFKA_BATCH_WAIT_S=1.0
# Redeliveries of a record MySQL rejects before it is quarantined to the DLQ.
INTENT_KAFKA_MAX_ATTEMPTS=3
# Consumers (threads) in this container. KEEP 1: with INTENT_KAFKA_ORDERING_DOMAIN=single the worker
# refuses to start with more, because the cross-topic ordering guarantee needs ONE consumer to own every
# partition. Scale out only via the copartitioned mode below.
INTENT_KAFKA_CONSUMER_THREADS=1
# Seconds between "stats" log lines (counters and per-partition lag).
INTENT_KAFKA_STATS_INTERVAL_S=60

# ---- Cross-topic ordering (docs/INTENT_KAFKA_WORKER.md) ----
# An actor's events sit on up to four topics. Records are applied in /track send order (Kafka timestamp),
# waiting for any lagging topic. single = exactly one consumer owns every partition (default);
# copartitioned = all four topics have the same partition count, so partition i of every topic goes to the
# same consumer and several consumers can share the load. A consumer that breaks the mode pauses and logs.
INTENT_KAFKA_ORDERING_DOMAIN=single
# Seconds a caught-up topic is still waited for, covering a record in flight to the log. Must be at least the
# producer's send deadline (5 s). Ingestion latency is about this plus 1 s.
INTENT_KAFKA_ORDER_SLACK_S=10
# Records buffered for ordering (also capped at 16 MiB). When full, partitions that are ahead are paused.
INTENT_KAFKA_ORDER_BUFFER_MAX=2000

# ---- Session rules (must equal the value /track used: alerts-service SESSION_TIMEOUT) ----
# Seconds of inactivity after which the next event starts a new session. Default 1800.
SESSION_TIMEOUT=1800

# ---- Brand routing ----
# JSON object: every brand_id /track can send (INTENT_BRANDS_ALLOWLIST in alerts-service) must
# map to the brand's MySQL database name. A brand that is missing is quarantined to the DLQ.
# A change needs a worker restart. Current production mapping:
#   bbb_shop -> BBB, pts_shop -> PTS, shyle_shop -> SHYLENEW
INTENT_DB_MAP={"bbb_shop":"BBB","pts_shop":"PTS","shyle_shop":"SHYLENEW"}

# ---- Brand database connections (pipeline/db.py, aws_background.py) ----
GET_BRANDS_API=
PASSWORD_AES_KEY=
PIPELINE_AUTH_HEADER=
DB_CONNECT_TIMEOUT_S=10
DB_READ_TIMEOUT_S=30
DB_WRITE_TIMEOUT_S=30
DB_RETRY_ATTEMPTS=3
DB_RETRY_BASE_DELAY_S=0.5
DB_TLS_CA_MODE=
DB_SSL_VERIFY_CERT=true
DB_SSL_VERIFY_IDENTITY=true
